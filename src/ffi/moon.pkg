import {
  "moonbitlang/core/json",
  "moonbitlang/async/io",
  "mizchi/x/http" @x_http,
  "mizchi/x/process" @x_process,
  "mizchi/x/sys" @x_sys,
}

warnings = "-0067"

options(
  "native-stub": [ "native_stub.c" ],
  targets: {
    "async_js.mbt": [ "js" ],
    "raw_js.mbt": [ "js" ],
    "raw_native.mbt": [ "native" ],
    "raw_wasm.mbt": [ "wasm", "wasm-gc" ],
    "string_conv.mbt": [ "native" ],
  },
)
